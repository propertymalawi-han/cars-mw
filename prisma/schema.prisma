generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  user
  dealer
  admin
  support
}

enum AccountType {
  individual
  dealer
}

enum SellerType {
  dealer
  private
}

enum ListingStatus {
  active
  sold
  draft
  expired
  muted
}

enum Transmission {
  automatic
  manual
}

enum FuelType {
  petrol
  diesel
  hybrid
  electric
}

enum BodyType {
  sedan
  suv
  pickup
  hatchback
  van
  other
}

enum EnquiryStatus {
  pending
  replied
  closed
}

enum CatalogStatus {
  active
  muted
}

model User {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  email         String      @unique
  emailVerified DateTime?   @map("email_verified") @db.Timestamptz(6)
  passwordHash  String?     @map("password_hash")
  avatarUrl     String?     @map("avatar_url")
  phone         String?
  accountType   AccountType @default(individual) @map("account_type")
  /// Internal access (admin/support). Marketplace seller/buyer behavior uses accountType.
  role            UserRole    @default(user)
  suspended       Boolean     @default(false)
  suspendedReason String?     @map("suspended_reason")
  suspendedAt     DateTime?   @map("suspended_at") @db.Timestamptz(6)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  dealer         Dealer?
  listings       Listing[]
  accounts       Account[]
  sessions       Session[]
  adminAuditLogs AdminAuditLog[]

  favourites               Favourite[]
  viewHistory              ViewHistory[]
  enquiries                Enquiry[]
  enquiryMessages          EnquiryMessage[]
  reviews                  Review[]
  notificationPreferences  NotificationPreference[]

  @@index([suspended])
  @@index([createdAt])
  @@map("users")
}

model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Dealer {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String   @unique
  logoUrl     String?  @map("logo_url")
  districts   String[]
  verified    Boolean  @default(false)
  phone       String
  whatsapp    String
  description String   @default("")
  userId      String   @unique @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  enquiries Enquiry[]
  reviews   Review[]

  @@map("dealers")
}

model Listing {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Sequential public vehicle ID, displayed as CMW-10001
  vehicleNumber Int            @unique @default(autoincrement()) @map("vehicle_number")
  title         String
  make         String
  model        String
  year         Int
  /// Price in Malawian Kwacha (integer, no decimals)
  price        Int
  mileage      Int
  transmission Transmission
  fuelType     FuelType       @map("fuel_type")
  bodyType     BodyType       @map("body_type")
  district     String
  city         String
  images       String[]
  description  String
  sellerId     String         @map("seller_id") @db.Uuid
  seller       User           @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  sellerType          SellerType     @map("seller_type")
  status              ListingStatus  @default(active)
  featuredUntil       DateTime?      @map("featured_until") @db.Timestamptz(6)
  mutedReason         String?        @map("muted_reason")
  mutedPreviousStatus ListingStatus? @map("muted_previous_status")
  deletedAt           DateTime?      @map("deleted_at") @db.Timestamptz(6)
  /// Set when status first becomes sold; used for time-to-sale analytics.
  soldAt              DateTime?      @map("sold_at") @db.Timestamptz(6)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  favourites  Favourite[]
  viewHistory ViewHistory[]
  enquiries   Enquiry[]

  @@index([status, createdAt(sort: Desc)])
  @@index([featuredUntil])
  @@index([deletedAt])
  @@index([soldAt])
  @@index([city])
  @@index([make])
  @@index([bodyType])
  @@index([district])
  @@index([price])
  @@index([status])
  @@index([createdAt])
  @@index([status, make])
  @@index([status, bodyType])
  @@index([status, district])
  @@index([make, model])
  @@index([sellerId, sellerType])
  @@map("listings")
}

model Favourite {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("favourites")
}

model ViewHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  viewedAt  DateTime @default(now()) @map("viewed_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId, viewedAt(sort: Desc)])
  @@index([listingId, viewedAt(sort: Desc)])
  @@map("view_history")
}

model Enquiry {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  listingId String        @map("listing_id") @db.Uuid
  dealerId  String?       @map("dealer_id") @db.Uuid
  message   String
  status    EnquiryStatus @default(pending)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing  Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  dealer   Dealer?           @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  messages EnquiryMessage[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([dealerId, createdAt(sort: Desc)])
  @@map("enquiries")
}

model EnquiryMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enquiryId String   @map("enquiry_id") @db.Uuid
  senderId  String   @map("sender_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([enquiryId, createdAt])
  @@map("enquiry_messages")
}

model Review {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  dealerId  String   @map("dealer_id") @db.Uuid
  rating    Int
  comment   String   @default("")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@unique([userId, dealerId])
  @@index([dealerId, createdAt(sort: Desc)])
  @@map("reviews")
}

model NotificationPreference {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  key             String
  emailEnabled    Boolean  @default(true) @map("email_enabled")
  smsEnabled      Boolean  @default(false) @map("sms_enabled")
  whatsappEnabled Boolean  @default(false) @map("whatsapp_enabled")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("notification_preferences")
}

model VehicleCategory {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  slug       String        @unique
  parentId   String?       @map("parent_id") @db.Uuid
  parent     VehicleCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   VehicleCategory[] @relation("CategoryTree")
  status     CatalogStatus @default(active)
  mutedUntil DateTime?     @map("muted_until") @db.Timestamptz(6)
  sortOrder  Int           @default(0) @map("sort_order")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([parentId, sortOrder])
  @@index([status, mutedUntil])
  @@map("vehicle_categories")
}

model Make {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String        @unique
  slug       String        @unique
  isPopular  Boolean       @default(false) @map("is_popular")
  sortOrder  Int           @default(0) @map("sort_order")
  status     CatalogStatus @default(active)
  mutedUntil DateTime?     @map("muted_until") @db.Timestamptz(6)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  models VehicleModel[]

  @@index([isPopular, sortOrder])
  @@index([status, mutedUntil])
  @@map("makes")
}

model VehicleModel {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  makeId     String        @map("make_id") @db.Uuid
  name       String
  slug       String
  bodyType   BodyType      @map("body_type")
  status     CatalogStatus @default(active)
  mutedUntil DateTime?     @map("muted_until") @db.Timestamptz(6)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  make     Make      @relation(fields: [makeId], references: [id], onDelete: Cascade)
  variants Variant[]

  @@unique([makeId, name])
  @@unique([makeId, slug])
  @@index([makeId])
  @@index([status, mutedUntil])
  @@map("models")
}

model Variant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  modelId   String   @map("model_id") @db.Uuid
  name      String
  fuelType  FuelType @map("fuel_type")
  notes     String   @default("")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  model VehicleModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, name])
  @@index([modelId])
  @@map("variants")
}

model AdminAuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId String   @map("admin_user_id") @db.Uuid
  action      String
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  admin User @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([createdAt(sort: Desc)])
  @@map("admin_audit_logs")
}
