# Auth.js (NextAuth v5) — generate with: openssl rand -base64 32
# Required on Vercel (Production + Preview). Redeploy after adding it.
# Do not set AUTH_URL to localhost on Vercel; omit it or use https://cars-mw.vercel.app
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google OAuth — create a Web client in Google Cloud Console.
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional extra transactional email (signup confirmation is sent by Supabase Auth)
RESEND_API_KEY=""
EMAIL_FROM="CarsMW <onboarding@resend.dev>"

# Photo uploads — Cloudinary (used first if set)
